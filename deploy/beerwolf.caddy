# Imported by the host /etc/caddy/Caddyfile. That file already has the
# global { email } block (must stay first) and shop-bot.beerwolf.site.
# This snippet is landing hosts only — a second shop-bot or { } here
# makes Caddy reject the config as ambiguous / “global must be first”.

shop.beerwolf.site, beerwolf.site {
	root * /root/caddy/site/beerwolf-current

	# Used by the deployment smoke check without reading a content file.
	@health path /healthz
	respond @health 200

	# Vite emits content-hashed files under /assets/.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	encode zstd gzip
	try_files {path} {path}/ /index.html
	file_server
}

