# Public Formspree endpoint used by the contact form, for example:
# https://formspree.io/f/your-form-id
VITE_FORMSPREE_ENDPOINT=

# Public path used by Vite. Keep "/" for local development and beerwolf.site.
# GitHub Pages overrides this in .github/workflows/pages.yml.
VITE_BASE_PATH=/

# Umami website UUID from the dashboard (Settings → Tracking code).
# Leave empty locally so development and tests do not send events.
VITE_UMAMI_WEBSITE_ID=

# Tracker script URL. Umami Cloud is the default when this is empty.
# Self-hosted example: https://analytics.example.com/script.js
VITE_UMAMI_SCRIPT_URL=

# Comma-separated hostnames that may send events. Defaults to shop.beerwolf.site
# so localhost and GitHub Pages do not pollute production stats.
VITE_UMAMI_DOMAINS=

# Optional API host when the script is served from a different origin than Umami.
VITE_UMAMI_HOST_URL=
